--!nocheck
-- Run: lune run TooltipPlacement.test.luau   (from the kit's systems folder, see check-scripts.sh)
local t = require("../../../../../systems/_check/harness")
local P = require("../TooltipPlacement")

local vp = { w = 800, h = 400 }
local tip = { w = 160, h = 60 }

t.test("prefers above, centred on the anchor", function()
	local s = P.place({ x = 400, y = 200, w = 40, h = 40 }, tip, vp, nil, 8)
	t.eq(s.side, "above")
	t.eq(s.x, 340)
	t.eq(s.y, 132)
end)
t.test("flips below when there is no room above", function()
	local s = P.place({ x = 400, y = 10, w = 40, h = 40 }, tip, vp, nil, 8)
	t.eq(s.side, "below")
	t.eq(s.y, 58)
end)
t.test("clamps horizontally inside the viewport", function()
	local s = P.place({ x = 770, y = 200, w = 30, h = 30 }, tip, vp, nil, 8)
	t.eq(s.x, 640)
end)
t.test("insets keep the tip out of the notch area", function()
	local s = P.place({ x = 0, y = 200, w = 30, h = 30 }, tip, vp, { left = 50, top = 0, right = 0, bottom = 0 }, 8)
	t.eq(s.x, 50)
end)
t.test("tiny viewport pins instead of leaving the screen", function()
	local s = P.place({ x = 5, y = 5, w = 20, h = 20 }, { w = 160, h = 60 }, { w = 100, h = 50 }, nil, 8)
	t.eq(s.side, "pinned")
	t.eq(s.x, 0)
	t.eq(s.y, 0)
end)
t.test("show rule per input", function()
	t.falsy(P.shouldShow("mouse", 0.1))
	t.truthy(P.shouldShow("mouse", 0.3))
	t.falsy(P.shouldShow("touch", 0.2))
	t.truthy(P.shouldShow("touch", 0.5))
	t.truthy(P.shouldShow("gamepad", 0))
	t.falsy(P.shouldShow("touch", 1, true))
end)
t.done()
