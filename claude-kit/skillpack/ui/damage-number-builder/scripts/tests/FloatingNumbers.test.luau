--!nocheck
-- Run: lune run FloatingNumbers.test.luau   (from the kit's systems folder, see check-scripts.sh)
local t = require("../../../../../systems/_check/harness")
local F = require("../FloatingNumbers")

t.test("hits on the same target inside the window merge", function()
	local f = F.new({ mergeWindow = 0.25 })
	local a, m1 = f:spawn("g", 10, "damage", 0)
	local b, m2 = f:spawn("g", 5, "damage", 0.2)
	t.falsy(m1)
	t.truthy(m2)
	t.eq(a.id, b.id)
	t.eq(b.total, 15)
end)
t.test("different target or kind never merges", function()
	local f = F.new()
	f:spawn("g", 10, "damage", 0)
	local _, merged = f:spawn("h", 10, "damage", 0.1)
	t.falsy(merged)
	local _, merged2 = f:spawn("g", 10, "heal", 0.1)
	t.falsy(merged2)
end)
t.test("a hit after the window starts a new number", function()
	local f = F.new({ mergeWindow = 0.25 })
	f:spawn("g", 10, "damage", 0)
	local _, merged = f:spawn("g", 10, "damage", 0.5)
	t.falsy(merged)
end)
t.test("lanes rotate and centre", function()
	local f = F.new({ lanes = 3 })
	local lanes = {}
	for i = 1, 4 do
		table.insert(lanes, (f:spawn("t" .. i, 1, "damage", 0)).lane)
	end
	t.eq(lanes, { 0, 1, 2, 0 })
	t.eq(f:laneOffset(0, 24), -24)
	t.eq(f:laneOffset(1, 24), 0)
	t.eq(f:laneOffset(2, 24), 24)
end)
t.test("cap drops the oldest", function()
	local f = F.new({ maxActive = 2 })
	f:spawn("a", 1, "damage", 0)
	f:spawn("b", 1, "damage", 0)
	f:spawn("c", 1, "damage", 0)
	local active = f:tick(0)
	t.eq(#active, 2)
	t.eq(active[1].target, "b")
end)
t.test("tick expires by age and progress is clamped", function()
	local f = F.new({ lifetime = 1, mergeWindow = 0.25 })
	local n = f:spawn("a", 1, "damage", 0)
	t.eq(#f:tick(0.5), 1)
	t.eq(f:progress(n, 0.5), 0.5)
	t.eq(#f:tick(1.5), 0)
	t.eq(f:progress(n, 9), 1)
end)
t.done()
