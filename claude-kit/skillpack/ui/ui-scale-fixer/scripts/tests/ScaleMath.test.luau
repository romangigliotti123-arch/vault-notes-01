--!nocheck
local t = require("../../../../../systems/_check/harness")
local M = require("../ScaleMath")

t.test("convert gives scale, aspect and caps", function()
	local p = M.convert({ w = 300, h = 100 }, { w = 1500, h = 1000 })
	t.eq(p.scaleX, 0.2)
	t.eq(p.scaleY, 0.1)
	t.eq(p.aspect, 3)
	t.eq(p.maxPx.w, 300)
	t.eq(p.minPx.w, 0)
end)
t.test("interactive objects get a touch floor, capped by design size", function()
	local p = M.convert({ w = 30, h = 30 }, { w = 1000, h = 1000 }, { interactive = true })
	t.eq(p.minPx.w, 30)
	local q = M.convert({ w = 200, h = 80 }, { w = 1000, h = 1000 }, { interactive = true })
	t.eq(q.minPx.h, 44)
end)
t.test("resolve is capped at the design size on big screens", function()
	local p = M.convert({ w = 300, h = 100 }, { w = 1000, h = 1000 })
	t.eq(M.resolve(p, { w = 3000, h = 2000 }).w, 300)
end)
t.test("sweep flags a wide button whose height falls under the touch floor", function()
	local p = M.convert({ w = 120, h = 20 }, { w = 1920, h = 1080 }, { interactive = true })
	local issues = M.sweep(p, M.EXAMPLE_VIEWPORTS)
	t.truthy(#issues >= 1)
	t.truthy(string.find(issues[1], "touch floor", 1, true))
end)
t.test("sweep flags an object wider than the viewport", function()
	local p = { scaleX = 1.2, scaleY = 0.1, aspect = 4, maxPx = { w = 5000, h = 1250 }, minPx = { w = 0, h = 0 } }
	t.eq(#M.sweep(p, { { name = "phone", w = 400, h = 300 } }), 1)
end)
t.done()
