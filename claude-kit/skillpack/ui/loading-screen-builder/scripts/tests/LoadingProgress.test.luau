--!nocheck
-- Run: lune run LoadingProgress.test.luau   (from the kit's systems folder, see check-scripts.sh)
local t = require("../../../../../systems/_check/harness")
local L = require("../LoadingProgress")

local function make()
	return L.new({ { name = "assets", weight = 6 }, { name = "data", weight = 3 }, { name = "spawn", weight = 1 } }, 10)
end

t.test("raw is the weighted fraction", function()
	local p = make()
	p:set("assets", 0.5)
	p:done("data")
	t.eq(p:raw(), 0.6)
end)
t.test("progress never moves backwards", function()
	local p = make()
	p:set("assets", 0.8)
	p:set("assets", 0.2)
	t.truthy(math.abs(p:raw() - 0.48) < 1e-9)
end)
t.test("the bar is capped below 1 until every task is done", function()
	local p = make()
	p:done("assets")
	p:done("data")
	t.truthy(p:update(10) < 1)
	p:done("spawn")
	t.eq(p:update(10), 1)
end)
t.test("the bar approaches smoothly at the speed limit", function()
	local p = L.new({ { name = "a", weight = 1 } }, 0.5)
	p:done("a")
	t.eq(p:update(1), 0.5)
	t.eq(p:update(1), 1)
end)
t.test("stalled after the timeout, not once complete", function()
	local p = make()
	p:set("assets", 0.1, 5)
	t.falsy(p:stalled(10, 10))
	t.truthy(p:stalled(15, 10))
	p:done("assets")
	p:done("data")
	p:done("spawn")
	t.falsy(p:stalled(99, 10))
end)
t.test("nextTip never repeats the last tip", function()
	for last = 1, 4 do
		for r = 0, 9 do
			t.truthy(L.nextTip(4, last, r / 10) ~= last)
		end
	end
	t.eq(L.nextTip(1, 1, 0.5), 1)
end)
t.done()
