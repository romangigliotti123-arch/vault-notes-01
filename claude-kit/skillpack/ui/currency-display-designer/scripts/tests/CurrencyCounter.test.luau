--!nocheck
local t = require("../../../../../systems/_check/harness")
local C = require("../CurrencyCounter")

t.test("format abbreviates and never rounds into the next unit", function()
	t.eq(C.format(0), "0")
	t.eq(C.format(999), "999")
	t.eq(C.format(1000), "1K")
	t.eq(C.format(1234567), "1.23M")
	t.eq(C.format(999999), "999.99K")
	t.eq(C.format(2500000000), "2.5B")
	t.eq(C.format(-1500), "-1.5K")
end)
t.test("count-up reaches the target within the duration and never overshoots", function()
	local c = C.new(0, { duration = 1 })
	c:set(1000)
	local v = 0
	for _ = 1, 10 do
		v = c:update(0.1)
		t.truthy(v <= 1000)
	end
	t.eq(v, 1000)
	t.truthy(c:isSettled())
end)
t.test("halfway shows about half", function()
	local c = C.new(0, { duration = 1 })
	c:set(1000)
	t.eq(c:update(0.5), 500)
end)
t.test("a decrease is instant by default and animated when asked", function()
	local c = C.new(500)
	c:set(100)
	t.eq(c:update(0), 100)
	local d = C.new(500, { instantOnDecrease = false, duration = 1 })
	d:set(100)
	t.eq(d:update(0.5), 300)
end)
t.test("snap resets to a server value", function()
	local c = C.new(0)
	c:set(900)
	c:snap(42)
	t.eq(c:update(1), 42)
end)
t.done()
