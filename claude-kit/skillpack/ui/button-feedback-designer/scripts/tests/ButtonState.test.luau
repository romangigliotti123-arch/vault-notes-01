--!nocheck
-- Run: lune run ButtonState.test.luau   (from the kit's systems folder, see check-scripts.sh)
local t = require("../../../../../systems/_check/harness")
local B = require("../ButtonState")

t.test("hover then press then release over the button activates", function()
	local b = B.new()
	b:send("enter")
	t.eq(b.state, "hover")
	b:send("down")
	t.eq(b.state, "pressed")
	t.truthy(b:send("up"))
	t.eq(b.state, "hover")
end)
t.test("leaving while pressed cancels the activation", function()
	local b = B.new()
	b:send("enter")
	b:send("down")
	b:send("leave")
	t.eq(b.state, "idle")
	t.falsy(b:send("up"))
end)
t.test("touch tap activates without a hover phase", function()
	local b = B.new()
	t.truthy(b:tap())
	t.eq(b.state, "idle")
end)
t.test("disabled, loading and owned never activate", function()
	for _, ev in { "disable", "load", "own" } do
		local b = B.new()
		b:send(ev)
		t.falsy(b:tap())
	end
end)
t.test("loading ends back in hover when the pointer is still over", function()
	local b = B.new()
	b:send("enter")
	b:send("load")
	t.eq(b.state, "loading")
	b:send("done")
	t.eq(b.state, "hover")
end)
t.test("pointer events while locked update hover tracking only", function()
	local b = B.new()
	b:send("disable")
	b:send("enter")
	t.eq(b.state, "disabled")
	b:send("enable")
	t.eq(b.state, "hover")
end)
t.test("missingStyles lists absent states", function()
	t.eq(B.missingStyles({ idle = 1, hover = 1, pressed = 1 }), { "disabled", "loading", "owned" })
end)
t.done()
