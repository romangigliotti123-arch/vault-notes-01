--!nocheck
local t = require("../../../../../systems/_check/harness")
local Q = require("../ToastQueue")

local function toast(key, p, text)
	return { key = key, text = text or key, priority = p or 1 }
end

t.test("shows up to the cap then queues, promoting on expiry", function()
	local q = Q.new({ maxVisible = 2, defaultTtl = 3, keyCooldown = 0 })
	t.eq(q:push(toast("a"), 0), "shown")
	t.eq(q:push(toast("b"), 0), "shown")
	t.eq(q:push(toast("c"), 0), "queued")
	t.eq(#q:tick(1), 2)
	local visible = q:tick(3)
	t.eq(#visible, 1)
	t.eq(visible[1].key, "c")
end)
t.test("a repeat of a visible key merges and counts", function()
	local q = Q.new({ keyCooldown = 2 })
	q:push(toast("coins", 1, "+5"), 0)
	t.eq(q:push(toast("coins", 1, "+10"), 1), "merged")
	local v = q:tick(1)
	t.eq(v[1].count, 2)
	t.eq(v[1].text, "+10")
end)
t.test("cooldown drops a repeat after the toast expired, allows it later", function()
	local q = Q.new({ keyCooldown = 5, defaultTtl = 1 })
	q:push(toast("x"), 0)
	q:tick(2)
	t.eq(q:push(toast("x"), 3), "dropped")
	t.eq(q:push(toast("x"), 6), "shown")
end)
t.test("queue picks the highest priority first", function()
	local q = Q.new({ maxVisible = 1, keyCooldown = 0, defaultTtl = 1 })
	q:push(toast("first"), 0)
	q:push(toast("low", 1), 0)
	q:push(toast("high", 50), 0)
	t.eq(q:tick(1)[1].key, "high")
end)
t.test("critical ignores cooldown and displaces the lowest visible", function()
	local q = Q.new({ maxVisible = 1, keyCooldown = 10 })
	q:push(toast("info", 1), 0)
	t.eq(q:push(toast("kicked", 100), 1), "shown")
	t.eq(q:tick(1)[1].key, "kicked")
end)
t.test("full queue drops the lowest priority newcomer", function()
	local q = Q.new({ maxVisible = 1, maxQueued = 1, keyCooldown = 0 })
	q:push(toast("v"), 0)
	q:push(toast("q", 5), 0)
	t.eq(q:push(toast("worse", 1), 0), "dropped")
	t.eq(q:push(toast("better", 9), 0), "queued")
	t.eq(q:queuedCount(), 1)
end)
t.done()
