--!strict
-- GENERATED by build_inline.py from Overlap.luau + collect.src. Edit those two, not this file.
local Overlap = {}

export type Item = {
	path: string,
	kind: string,
	x: number,
	y: number,
	w: number,
	h: number,
	order: number,
	opaque: boolean?,
	popup: boolean?,
	textPx: number?,
	fg: { number }?,
	bg: { number }?,
}
export type Viewport = { name: string, w: number, h: number }
export type Finding = { rule: string, a: string, b: string?, detail: string }
export type Options = {
	minTextPx: number?,
	overlapShare: number?,
	maxPanelShare: number?,
	maxCoverage: number?,
	topInset: number?,
}

local function isRelated(a: string, b: string): boolean
	return a == b or string.sub(a, 1, #b + 1) == b .. "." or string.sub(b, 1, #a + 1) == a .. "."
end

function Overlap.intersection(a: Item, b: Item): number
	local w = math.min(a.x + a.w, b.x + b.w) - math.max(a.x, b.x)
	local h = math.min(a.y + a.h, b.y + b.h) - math.max(a.y, b.y)
	if w <= 0 or h <= 0 then
		return 0
	end
	return w * h
end

local function channel(c: number): number
	if c <= 0.03928 then
		return c / 12.92
	end
	return ((c + 0.055) / 1.055) ^ 2.4
end

local function luminance(c: { number }): number
	return 0.2126 * channel(c[1]) + 0.7152 * channel(c[2]) + 0.0722 * channel(c[3])
end

function Overlap.contrast(a: { number }, b: { number }): number
	local la, lb = luminance(a), luminance(b)
	return (math.max(la, lb) + 0.05) / (math.min(la, lb) + 0.05)
end

local function fmt(n: number): string
	return string.format("%.0f", n)
end

function Overlap.analyse(items: { Item }, vp: Viewport, opts: Options?): { Finding }
	local o: Options = opts or {}
	local minText = o.minTextPx or 14
	local share = o.overlapShare or 0.05
	local maxPanel = o.maxPanelShare or 0.35
	local maxCover = o.maxCoverage or 0.4
	local top = o.topInset or 0
	local out: { Finding } = {}
	local vpArea = vp.w * vp.h
	local covered = 0
	local popups: { string } = {}

	for _, it in items do
		if it.x < -2 or it.y < top - 2 or it.x + it.w > vp.w + 2 or it.y + it.h > vp.h + 2 then
			table.insert(out, {
				rule = "off-screen",
				a = it.path,
				detail = `rect {fmt(it.x)},{fmt(it.y)} {fmt(it.w)}x{fmt(it.h)} leaves the {vp.w}x{vp.h} viewport`,
			})
		end
		local px = it.textPx
		if px ~= nil then
			if px < minText then
				table.insert(
					out,
					{ rule = "small-text", a = it.path, detail = `{fmt(px)}px under {minText}px at {vp.name}` }
				)
			end
			if it.fg and it.bg then
				local ratio = Overlap.contrast(it.fg, it.bg)
				local need = if px >= 24 then 3 else 4.5
				if ratio < need then
					table.insert(out, {
						rule = "low-contrast",
						a = it.path,
						detail = string.format("contrast %.1f:1 under %.1f:1", ratio, need),
					})
				end
			end
		end
		if it.kind == "panel" and not it.popup then
			local a = it.w * it.h
			covered += a
			if a / vpArea > maxPanel then
				table.insert(out, {
					rule = "panel-too-big",
					a = it.path,
					detail = string.format("%.0f%% of the screen", 100 * a / vpArea),
				})
			end
		end
		if it.popup then
			table.insert(popups, it.path)
		end
		if it.kind == "button" and vp.w <= 1000 then
			local left =
				{ path = "", kind = "zone", x = 0, y = vp.h * 0.55, w = vp.w * 0.25, h = vp.h * 0.45, order = 0 }
			local right = {
				path = "",
				kind = "zone",
				x = vp.w * 0.75,
				y = vp.h * 0.55,
				w = vp.w * 0.25,
				h = vp.h * 0.45,
				order = 0,
			}
			local small = it.w * it.h
			if Overlap.intersection(it, left) > 0.2 * small or Overlap.intersection(it, right) > 0.2 * small then
				table.insert(
					out,
					{ rule = "touch-zone", a = it.path, detail = "button sits in the thumbstick or jump zone" }
				)
			end
		end
	end

	for i = 1, #items do
		for j = i + 1, #items do
			local a, b = items[i], items[j]
			if not isRelated(a.path, b.path) then
				local area = Overlap.intersection(a, b)
				if area > 0 then
					local smaller = math.min(a.w * a.h, b.w * b.h)
					if smaller > 0 and area / smaller > share then
						local top_, under = a, b
						if b.order > a.order then
							top_, under = b, a
						end
						local rule = "overlap"
						local detail = string.format(
							"%s %s covers %.0f%% of %s %s",
							top_.kind,
							top_.path,
							100 * area / smaller,
							under.kind,
							under.path
						)
						if top_.opaque and under.kind ~= "panel" and area / (under.w * under.h) > 0.5 then
							rule = "hidden-behind"
							detail = string.format(
								"%s %s is %.0f%% hidden behind %s",
								under.kind,
								under.path,
								100 * area / (under.w * under.h),
								top_.path
							)
						end
						table.insert(out, { rule = rule, a = a.path, b = b.path, detail = detail })
					end
				end
			end
		end
	end

	if covered / vpArea > maxCover then
		table.insert(out, {
			rule = "ui-coverage",
			a = "HUD",
			detail = string.format("panels cover %.0f%% of the screen", 100 * covered / vpArea),
		})
	end
	if #popups > 1 then
		table.insert(
			out,
			{ rule = "popup-stack", a = popups[1], b = popups[2], detail = `{#popups} popups visible at once` }
		)
	end
	return out
end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local CONFIG = {
	viewports = {
		{ name = "phone", w = 844, h = 390 },
		{ name = "tablet", w = 1180, h = 820 },
		{ name = "desktop", w = 1920, h = 1080 },
	} :: { Viewport },
	render = nil :: string?,
	clean = false,
}

local PREVIEW = "__VQA_Preview"
local TOPBAR = 36

if not (RunService:IsClient() and Players.LocalPlayer) then
	error("run this in a Client playtest datamodel (start_stop_play, then execute_luau with datamodel Client)")
end
local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui
local old = playerGui:FindFirstChild(PREVIEW)
if old then
	old:Destroy()
end
if CONFIG.clean then
	print("preview removed")
	return
end

local function popupName(n: string): boolean
	local l = string.lower(n)
	return string.find(l, "popup") ~= nil
		or string.find(l, "modal") ~= nil
		or string.find(l, "banner") ~= nil
		or string.find(l, "toast") ~= nil
		or string.find(l, "dialog") ~= nil
end

local function effectivelyVisible(g: GuiObject, stop: Instance): boolean
	local cur: Instance? = g
	while cur and cur ~= stop do
		if cur:IsA("GuiObject") and not (cur :: GuiObject).Visible then
			return false
		end
		if cur:IsA("CanvasGroup") and (cur :: CanvasGroup).GroupTransparency > 0.95 then
			return false
		end
		cur = cur.Parent
	end
	return true
end

local function segment(inst: Instance): string
	local parent = inst.Parent
	local idx = if parent then table.find(parent:GetChildren(), inst) or 0 else 0
	return `{inst.Name}[{idx}]`
end

local function relPath(inst: Instance, root: Instance, prefix: string): string
	local parts = {}
	local cur: Instance? = inst
	while cur and cur ~= root do
		table.insert(parts, 1, segment(cur))
		cur = cur.Parent
	end
	return prefix .. "." .. table.concat(parts, ".")
end

local function nearestBg(g: GuiObject, stop: Instance): { number }?
	local cur: Instance? = g
	while cur and cur ~= stop do
		if cur:IsA("GuiObject") and (cur :: GuiObject).BackgroundTransparency < 0.5 then
			local c = (cur :: GuiObject).BackgroundColor3
			return { c.R, c.G, c.B }
		end
		cur = cur.Parent
	end
	return nil
end

local preview = Instance.new("ScreenGui")
preview.Name = PREVIEW
preview.IgnoreGuiInset = true
preview.ResetOnSpawn = false
preview.DisplayOrder = 1000
preview.Parent = playerGui

local sources: { ScreenGui } = {}
for _, g in playerGui:GetChildren() do
	if g:IsA("ScreenGui") and g ~= preview and (g :: ScreenGui).Enabled then
		table.insert(sources, g :: ScreenGui)
	end
end

local total = 0
for _, vp in CONFIG.viewports do
	local host = Instance.new("Frame")
	host.Name = "vp_" .. vp.name
	host.Size = UDim2.fromOffset(vp.w, vp.h)
	host.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	host.BorderSizePixel = 0
	host.ClipsDescendants = true
	host.Parent = preview
	local items: { Item } = {}
	local seq = 0
	for _, src in sources do
		local inset = if src.IgnoreGuiInset then 0 else TOPBAR
		local box = Instance.new("Frame")
		box.Name = src.Name
		box.BackgroundTransparency = 1
		box.Position = UDim2.fromOffset(0, inset)
		box.Size = UDim2.new(1, 0, 1, -inset)
		box.Parent = host
		for _, child in src:GetChildren() do
			if not child:IsA("LuaSourceContainer") then
				local c = child:Clone()
				for _, d in c:GetDescendants() do
					if d:IsA("LuaSourceContainer") then
						d:Destroy()
					end
				end
				c.Parent = box
			end
		end
		task.wait(0.15)
		for _, d in box:GetDescendants() do
			if d:IsA("GuiObject") and effectivelyVisible(d, box) and d.AbsoluteSize.X > 0 and d.AbsoluteSize.Y > 0 then
				seq += 1
				local rel = d.AbsolutePosition - host.AbsolutePosition
				local item: Item = {
					path = relPath(d, box, src.Name),
					kind = "panel",
					x = rel.X,
					y = rel.Y,
					w = d.AbsoluteSize.X,
					h = d.AbsoluteSize.Y,
					order = src.DisplayOrder * 1000000 + d.ZIndex * 1000 + seq,
					opaque = d.BackgroundTransparency < 0.1,
				}
				local isText = d:IsA("TextLabel") or d:IsA("TextButton")
				if isText then
					local t = d :: TextLabel
					if t.Text == "" or t.TextTransparency > 0.95 then
						isText = false
					else
						item.textPx = t.TextBounds.Y
						item.fg = { t.TextColor3.R, t.TextColor3.G, t.TextColor3.B }
						item.bg = nearestBg(d, box)
					end
				end
				if d:IsA("TextButton") or d:IsA("ImageButton") then
					item.kind = "button"
				elseif isText then
					item.kind = "text"
				elseif
					d.BackgroundTransparency > 0.95
					and not (d:IsA("ImageLabel") and (d :: ImageLabel).ImageTransparency < 0.95)
				then
					item.kind = "skip"
				end
				if
					(d:IsA("Frame") or d:IsA("CanvasGroup")) and (d:GetAttribute("Popup") == true or popupName(d.Name))
				then
					item.popup = true
				end
				if item.kind ~= "skip" then
					table.insert(items, item)
				end
			end
		end
	end
	local findings = Overlap.analyse(items, vp, { topInset = TOPBAR })
	total += #findings
	print(`UI-OVERLAP {vp.name} {vp.w}x{vp.h}: {#items} visible items, {#findings} findings`)
	for _, f in findings do
		print(`  [{f.rule}] {f.a}{if f.b then " vs " .. f.b else ""}: {f.detail}`)
	end
	if CONFIG.render == vp.name then
		host.Position = UDim2.fromOffset(0, 0)
	else
		host:Destroy()
	end
end
if CONFIG.render == nil then
	preview:Destroy()
end
print(`UI-OVERLAP TOTAL {total} findings across {#CONFIG.viewports} viewports (0 required for the gate)`)
