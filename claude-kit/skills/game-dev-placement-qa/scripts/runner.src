-- run: edit CONFIG, then paste the whole file into execute_luau (datamodel Edit for the built map; Server during a playtest for models spawned at runtime).
--   mode "scan"   every placed object under CONFIG.root (default Workspace): the full-map placement scan the gate needs.
--   mode "verify" only the models at CONFIG.paths (read-only, intents from their stored attribute / the name).
--   mode "place"  CONFIG.build() returns { { model = <Instance>, intent = { ... } }, ... }; each is parented, auto-fixed and re-verified.
-- Output lines: PLACEMENT_MODEL <json> per model, PLACEMENT_SCAN <json> (scan mode), PLACEMENT: PASS|FAIL ... Save the console output to a file and run
-- `python placement_gate.py ingest <file> --game <slug> --write Games/<slug>` to turn it into the stored scan.
local CONFIG = {
	mode = "scan",
	game = nil :: string?,
	scorer = "builder", -- the critic runs its own scan with "critic"
	root = "Workspace",
	paths = {} :: { string },
	build = nil :: (() -> { { model: Instance, intent: { [string]: any }? } })?,
	opts = {
		includeInputs = false, -- true: each report carries its snapshot + environment so placement_gate.py can re-check it offline
		core = {
			-- defaultYawGrid = 15, floatTol = 0.1, buryTol = 0.25,
			-- bounds = { min = { -512, -50, -512 }, max = { 512, 400, 512 } },
		},
		-- intents = { ["Workspace.Map.Door1"] = { kind = "door", face = { target = "Workspace.Map.Hall" } } },
		-- rules = { { pattern = "^lamp", intent = { kind = "lamp" } } },
		-- defaultIntent = {},
	} :: { [string]: any },
}

local results: { { [string]: any } } = {}
local scanTable: { [string]: any }? = nil
local world = Placement.getWorld()
if CONFIG.mode == "scan" then
	local base: Instance? = if CONFIG.root == "Workspace" then world.root() else world.resolve(CONFIG.root)
	assert(base, "root not found: " .. tostring(CONFIG.root))
	local opts = CONFIG.opts
	opts.game, opts.scorer = CONFIG.game, CONFIG.scorer
	local scan = Placement.scan(base, opts)
	scanTable = scan
	results = scan.models
elseif CONFIG.mode == "verify" then
	for _, path in CONFIG.paths do
		local inst = world.resolve(path)
		assert(inst, "not found: " .. path)
		local rep = Placement.verify(inst, nil, CONFIG.opts)
		print("PLACEMENT_MODEL " .. world.jsonEncode(rep))
		table.insert(results, rep)
	end
elseif CONFIG.mode == "place" then
	assert(CONFIG.build, "mode place needs CONFIG.build")
	for _, item in CONFIG.build() do
		table.insert(results, Placement.place(item.model, item.intent, CONFIG.opts))
	end
end

local failing = {}
for _, r in results do
	if r.status ~= "pass" then
		table.insert(failing, r.path .. " (" .. table.concat(r.failed, ",") .. ")")
	end
end
print(
	string.format(
		"PLACEMENT: %s %d/%d models pass%s",
		if #failing == 0 then "PASS" else "FAIL",
		#results - #failing,
		#results,
		if #failing == 0 then "" else "; failing: " .. table.concat(failing, "; ")
	)
)
return scanTable
