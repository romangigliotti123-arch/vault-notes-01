local CONFIG = {
	mode = "scan",
	game = nil :: string?,
	scorer = "builder",
	root = "Workspace",
	paths = {} :: { string },
	build = nil :: (() -> { { model: Instance, intent: { [string]: any }? } })?,
	opts = {
		includeInputs = false,
		core = {},
	} :: { [string]: any },
}

local results: { { [string]: any } } = {}
local scanTable: { [string]: any }? = nil
local world = Placement.getWorld()
if CONFIG.mode == "scan" then
	local base: Instance? = if CONFIG.root == "Workspace" then world.root() else world.resolve(CONFIG.root)
	assert(base, "root not found: " .. tostring(CONFIG.root))
	local opts = CONFIG.opts
	opts.game, opts.scorer = CONFIG.game, CONFIG.scorer
	local scan = Placement.scan(base, opts)
	scanTable = scan
	results = scan.models
elseif CONFIG.mode == "verify" then
	for _, path in CONFIG.paths do
		local inst = world.resolve(path)
		assert(inst, "not found: " .. path)
		local rep = Placement.verify(inst, nil, CONFIG.opts)
		print("PLACEMENT_MODEL " .. world.jsonEncode(rep))
		table.insert(results, rep)
	end
elseif CONFIG.mode == "place" then
	assert(CONFIG.build, "mode place needs CONFIG.build")
	for _, item in CONFIG.build() do
		table.insert(results, Placement.place(item.model, item.intent, CONFIG.opts))
	end
end

local failing = {}
for _, r in results do
	if r.status ~= "pass" then
		table.insert(failing, r.path .. " (" .. table.concat(r.failed, ",") .. ")")
	end
end
print(
	string.format(
		"PLACEMENT: %s %d/%d models pass%s",
		if #failing == 0 then "PASS" else "FAIL",
		#results - #failing,
		#results,
		if #failing == 0 then "" else "; failing: " .. table.concat(failing, "; ")
	)
)
return scanTable
